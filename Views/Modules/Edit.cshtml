@model GestionFormations.Models.Module
@{
    ViewData["Title"] = "Modifier le Module";
}

<div class="page-header">
    <h2><i class="bi bi-pencil me-2"></i>Modifier le Module</h2>
    <p>Modifier les informations du module</p>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card" style="border: none; border-radius: 1rem; box-shadow: 0 4px 20px rgba(0,0,0,0.06);">
            <div class="card-body p-4">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="Id" />

                    <div class="mb-3">
                        <label asp-for="Titre" class="form-label text-uppercase fw-semibold small text-muted"></label>
                        <input asp-for="Titre" class="form-control" style="border: 2px solid #e0e0e0; border-radius: 0.5rem;" />
                        <span asp-validation-for="Titre" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label text-uppercase fw-semibold small text-muted"></label>
                        <textarea asp-for="Description" class="form-control" rows="3" style="border: 2px solid #e0e0e0; border-radius: 0.5rem;"></textarea>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label asp-for="Ordre" class="form-label text-uppercase fw-semibold small text-muted"></label>
                            <input asp-for="Ordre" class="form-control" style="border: 2px solid #e0e0e0; border-radius: 0.5rem;" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="DureeHeures" class="form-label text-uppercase fw-semibold small text-muted"></label>
                            <input asp-for="DureeHeures" class="form-control" style="border: 2px solid #e0e0e0; border-radius: 0.5rem;" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="FormationId" class="form-label text-uppercase fw-semibold small text-muted"></label>
                            <select asp-for="FormationId" class="form-select" style="border: 2px solid #e0e0e0; border-radius: 0.5rem;">
                                @if (ViewBag.Formations != null)
                                {
                                    @foreach (GestionFormations.Models.Formation f in ViewBag.Formations)
                                    {
                                        <option value="@f.Id" selected="@(f.Id == Model.FormationId)">@f.Titre</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-2"></i>Enregistrer</button>
                        <a asp-controller="Formations" asp-action="Edit" asp-route-id="@Model.FormationId" class="btn btn-outline-secondary">Annuler</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
