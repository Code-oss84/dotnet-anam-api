@model IEnumerable<GestionFormations.Models.Inscription>
@{
    ViewData["Title"] = "Gestion des Inscriptions";
}

<div class="page-header">
    <h2><i class="bi bi-clipboard-check me-2"></i>Gestion des Inscriptions</h2>
    <p>Administration des inscriptions aux formations</p>
</div>

<div class="btn-group mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-grid me-1"></i>Toutes</a>
    <a asp-action="Index" asp-route-statut="EnAttente" class="btn btn-outline-warning"><i class="bi bi-clock me-1"></i>En attente</a>
    <a asp-action="Index" asp-route-statut="Acceptee" class="btn btn-outline-success"><i class="bi bi-check-circle me-1"></i>Acceptées</a>
    <a asp-action="Index" asp-route-statut="Refusee" class="btn btn-outline-danger"><i class="bi bi-x-circle me-1"></i>Refusées</a>
</div>

<div class="card" style="border: none; border-radius: 1rem; box-shadow: 0 4px 20px rgba(0,0,0,0.06);">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Apprenant</th>
                        <th>Formation</th>
                        <th>Date</th>
                        <th>Statut</th>
                        <th>Note</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@item.Apprenant?.Prenom @item.Apprenant?.Nom</td>
                            <td>@item.Formation?.Titre</td>
                            <td>@item.DateInscription.ToString("dd/MM/yyyy")</td>
                            <td>
                                @switch (item.Statut)
                                {
                                    case GestionFormations.Models.StatutInscription.EnAttente:
                                        <span class="badge bg-warning rounded-pill">En attente</span>
                                        break;
                                    case GestionFormations.Models.StatutInscription.Acceptee:
                                        <span class="badge bg-success rounded-pill">Acceptée</span>
                                        break;
                                    case GestionFormations.Models.StatutInscription.Refusee:
                                        <span class="badge bg-danger rounded-pill">Refusée</span>
                                        break;
                                    default:
                                        <span class="badge bg-info rounded-pill">Terminée</span>
                                        break;
                                }
                            </td>
                            <td class="fw-semibold">@(item.NoteFinale?.ToString("F1") ?? "-")</td>
                            <td class="text-center">
                                @if (item.Statut == GestionFormations.Models.StatutInscription.EnAttente)
                                {
                                    <a asp-action="Traiter" asp-route-id="@item.Id" asp-route-statut="Acceptee" class="btn btn-sm btn-success"><i class="bi bi-check-lg"></i></a>
                                    <a asp-action="Traiter" asp-route-id="@item.Id" asp-route-statut="Refusee" class="btn btn-sm btn-danger"><i class="bi bi-x-lg"></i></a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
