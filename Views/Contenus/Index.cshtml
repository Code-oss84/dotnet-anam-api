@model IEnumerable<GestionFormations.Models.Contenu>
@{
    ViewData["Title"] = "Contenus";
}

<div class="page-header">
    <div class="d-flex justify-content-between align-items-center w-100">
        <div>
            <h2><i class="bi bi-file-earmark-text me-2"></i>Contenus</h2>
            <p>Gestion des contenus pédagogiques</p>
        </div>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-2"></i>Ajouter</a>
    </div>
</div>

<div class="card" style="border: none; border-radius: 1rem; box-shadow: 0 4px 20px rgba(0,0,0,0.06);">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Ordre</th>
                        <th>Titre</th>
                        <th>Type</th>
                        <th>Module</th>
                        <th>Durée</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><span class="badge bg-secondary rounded-pill">@item.Ordre</span></td>
                            <td class="fw-bold">@item.Titre</td>
                            <td>
                                @switch (item.Type)
                                {
                                    case GestionFormations.Models.TypeContenu.Cours:
                                        <span class="content-tag cours"><i class="bi bi-book me-1"></i>Cours</span>
                                        break;
                                    case GestionFormations.Models.TypeContenu.Exercice:
                                        <span class="content-tag exercice"><i class="bi bi-pencil me-1"></i>Exercice</span>
                                        break;
                                    case GestionFormations.Models.TypeContenu.Examen:
                                        <span class="content-tag examen"><i class="bi bi-clipboard-check me-1"></i>Examen</span>
                                        break;
                                    case GestionFormations.Models.TypeContenu.Quiz:
                                        <span class="content-tag quiz"><i class="bi bi-question-circle me-1"></i>Quiz</span>
                                        break;
                                }
                            </td>
                            <td>@item.Module?.Titre</td>
                            <td><i class="bi bi-clock me-1 text-muted"></i>@item.DureeMinutes min</td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="Détails"><i class="bi bi-info-circle"></i></a>
                                <a asp-controller="Questions" asp-action="Index" asp-route-contenuId="@item.Id" class="btn btn-sm btn-outline-secondary" title="Questions"><i class="bi bi-question-circle"></i></a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Modifier"><i class="bi bi-pencil"></i></a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Supprimer"><i class="bi bi-trash"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
