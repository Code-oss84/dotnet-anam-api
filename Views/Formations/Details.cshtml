@model GestionFormations.Models.Formation
@{
    ViewData["Title"] = Model.Titre;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Formations</a></li>
        <li class="breadcrumb-item active">@Model.Titre</li>
    </ol>
</nav>

<div class="row g-4">
    <div class="col-lg-8">
        <h2 class="fw-bold mb-3" style="color:var(--text);">@Model.Titre</h2>

        <div class="mb-3">
            @if (Model.Categorie != null)
            {
                <span class="badge fs-6" style="background:linear-gradient(135deg,var(--primary),var(--primary-dark));color:#fff;">@Model.Categorie.Nom</span>
            }
            @if (!Model.EstActive)
            {
                <span class="badge bg-secondary fs-6">Inactive</span>
            }
        </div>

        @if (!string.IsNullOrEmpty(Model.Description))
        {
            <div class="card mb-4" style="border:none;box-shadow:var(--shadow);border-radius:var(--radius-lg);">
                <div class="card-body">
                    <h5 class="fw-bold mb-3" style="color:var(--text);">Description</h5>
                    <p style="color:var(--text-muted);">@Model.Description</p>
                </div>
            </div>
        }

        @if (Model.Modules != null && Model.Modules.Any())
        {
            <h4 class="mb-3 fw-bold" style="color:var(--text);"><i class="bi bi-collection me-2"></i>Modules</h4>
            <div class="accordion" id="modulesAccordion">
                @foreach (var module in Model.Modules.OrderBy(m => m.Ordre))
                {
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#module-@module.Id">
                                <span class="badge bg-secondary me-2">@module.Ordre</span>
                                @module.Titre
                                <span class="ms-auto text-muted small">@module.DureeHeures h</span>
                            </button>
                        </h2>
                        <div id="module-@module.Id" class="accordion-collapse collapse show" data-bs-parent="#modulesAccordion">
                            <div class="accordion-body">
                                @if (!string.IsNullOrEmpty(module.Description))
                                {
                                    <p style="color:var(--text-muted);">@module.Description</p>
                                }
                                @if (module.Contenus != null && module.Contenus.Any())
                                {
                                    <div class="list-group list-group-flush">
                                        @foreach (var contenu in module.Contenus.OrderBy(c => c.Ordre))
                                        {
                                            <a asp-controller="Contenus" asp-action="Details" asp-route-id="@contenu.Id" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                                <span>
                                                    @switch (contenu.Type)
                                                    {
                                                        case GestionFormations.Models.TypeContenu.Cours:
                                                            <i class="bi bi-book text-primary me-2"></i>
                                                            break;
                                                        case GestionFormations.Models.TypeContenu.Exercice:
                                                            <i class="bi bi-pencil text-warning me-2"></i>
                                                            break;
                                                        case GestionFormations.Models.TypeContenu.Examen:
                                                            <i class="bi bi-clipboard-check text-danger me-2"></i>
                                                            break;
                                                        case GestionFormations.Models.TypeContenu.Quiz:
                                                            <i class="bi bi-question-circle text-success me-2"></i>
                                                            break;
                                                    }
                                                    @contenu.Titre
                                                </span>
                                                <span class="badge bg-light text-dark">@contenu.DureeMinutes min</span>
                                            </a>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <div class="col-lg-4">
        <div class="card sticky-top" style="top:80px;border:none;box-shadow:var(--shadow);border-radius:var(--radius-lg);overflow:hidden;">
            <div class="card-body">
                <div class="text-center mb-3">
                    <span class="fs-3 fw-bold" style="color:var(--primary);">@Model.Prix.ToString("N0") MAD</span>
                </div>
                <hr style="border-color:var(--border);" />
                <ul class="list-unstyled">
                    <li class="mb-3 d-flex align-items-center">
                        <span class="me-3" style="width:36px;height:36px;border-radius:10px;background:rgba(99,102,241,0.1);display:flex;align-items:center;justify-content:center;color:var(--primary);"><i class="bi bi-calendar"></i></span>
                        <div><small style="color:var(--text-muted);">Du</small><br /><strong>@Model.DateDebut.ToString("dd/MM/yyyy")</strong></div>
                    </li>
                    <li class="mb-3 d-flex align-items-center">
                        <span class="me-3" style="width:36px;height:36px;border-radius:10px;background:rgba(16,185,129,0.1);display:flex;align-items:center;justify-content:center;color:var(--success);"><i class="bi bi-calendar-check"></i></span>
                        <div><small style="color:var(--text-muted);">Au</small><br /><strong>@Model.DateFin.ToString("dd/MM/yyyy")</strong></div>
                    </li>
                    <li class="mb-3 d-flex align-items-center">
                        <span class="me-3" style="width:36px;height:36px;border-radius:10px;background:rgba(59,130,246,0.1);display:flex;align-items:center;justify-content:center;color:var(--info);"><i class="bi bi-clock"></i></span>
                        <div><small style="color:var(--text-muted);">Durée</small><br /><strong>@Model.DureeHeures heures</strong></div>
                    </li>
                    <li class="mb-3 d-flex align-items-center">
                        <span class="me-3" style="width:36px;height:36px;border-radius:10px;background:rgba(245,158,11,0.1);display:flex;align-items:center;justify-content:center;color:var(--warning);"><i class="bi bi-people"></i></span>
                        <div><small style="color:var(--text-muted);">Places</small><br /><strong>@Model.NombrePlaces places</strong></div>
                    </li>
                    @if (Model.Formateur != null)
                    {
                        <li class="mb-3 d-flex align-items-center">
                            <span class="me-3" style="width:36px;height:36px;border-radius:10px;background:rgba(139,92,246,0.1);display:flex;align-items:center;justify-content:center;color:#8b5cf6;"><i class="bi bi-person"></i></span>
                            <div><small style="color:var(--text-muted);">Formateur</small><br /><strong>@Model.Formateur.Prenom @Model.Formateur.Nom</strong></div>
                        </li>
                    }
                </ul>

                @if (User.Identity != null && User.Identity.IsAuthenticated && !User.IsInRole("Admin"))
                {
                    <form asp-controller="Inscriptions" asp-action="SInscrire" method="post">
                        <input type="hidden" name="formationId" value="@Model.Id" />
                        <button type="submit" class="btn btn-primary w-100 mt-3">
                            <i class="bi bi-journal-plus me-2"></i>S'inscrire
                        </button>
                    </form>
                }
                else if (User.Identity == null || !User.Identity.IsAuthenticated)
                {
                    <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-outline-primary w-100 mt-3">
                        <i class="bi bi-box-arrow-in-right me-2"></i>Connectez-vous pour vous inscrire
                    </a>
                }

                <a asp-controller="AiTrainer" asp-action="Index" asp-route-formationId="@Model.Id" class="btn btn-success w-100 mt-2">
                    <i class="bi bi-robot me-2"></i>Former avec l'IA
                </a>
            </div>
        </div>
    </div>
</div>
