@model GestionFormations.Models.Formation
@{
    ViewData["Title"] = "Supprimer la Formation";
}

<div class="page-header" style="background:linear-gradient(135deg,#991b1b,#7f1d1d,#6b1010);">
    <h2><i class="bi bi-trash me-2"></i>Supprimer la Formation</h2>
    <p>Cette action est irréversible</p>
</div>

<div class="row g-4 justify-content-center">
    <div class="col-md-8">
        <div class="card" style="border:2px solid var(--danger);border-radius:var(--radius-lg);box-shadow:var(--shadow);overflow:hidden;">
            <div class="card-body p-4">
                <h4 class="fw-bold mb-3" style="color:var(--text);">@Model.Titre</h4>
                <p style="color:var(--text-muted);">@Model.Description</p>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <div class="d-flex align-items-center p-3" style="background:var(--surface-alt);border-radius:var(--radius);">
                            <span class="me-3" style="width:40px;height:40px;border-radius:10px;background:rgba(99,102,241,0.1);display:flex;align-items:center;justify-content:center;color:var(--primary);"><i class="bi bi-currency-dollar"></i></span>
                            <div>
                                <small style="color:var(--text-muted);">Prix</small><br />
                                <strong>@Model.Prix.ToString("N0") MAD</strong>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="d-flex align-items-center p-3" style="background:var(--surface-alt);border-radius:var(--radius);">
                            <span class="me-3" style="width:40px;height:40px;border-radius:10px;background:rgba(16,185,129,0.1);display:flex;align-items:center;justify-content:center;color:var(--success);"><i class="bi bi-tag"></i></span>
                            <div>
                                <small style="color:var(--text-muted);">Catégorie</small><br />
                                <strong>@(Model.Categorie?.Nom ?? "—")</strong>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="d-flex align-items-center p-3" style="background:var(--surface-alt);border-radius:var(--radius);">
                            <span class="me-3" style="width:40px;height:40px;border-radius:10px;background:rgba(139,92,246,0.1);display:flex;align-items:center;justify-content:center;color:#8b5cf6;"><i class="bi bi-person"></i></span>
                            <div>
                                <small style="color:var(--text-muted);">Formateur</small><br />
                                <strong>@(Model.Formateur != null ? $"{Model.Formateur.Prenom} {Model.Formateur.Nom}" : "—")</strong>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="alert d-flex align-items-center" style="background:rgba(245,158,11,0.1);border:1px solid rgba(245,158,11,0.2);color:#92400e;border-radius:var(--radius);">
                    <i class="bi bi-exclamation-triangle-fill me-3 fs-5"></i>
                    <div>
                        <strong>Attention :</strong> Êtes-vous sûr de vouloir supprimer cette formation ? Cette action est irréversible.
                    </div>
                </div>

                <form asp-action="Delete" class="d-flex gap-2">
                    <input type="hidden" asp-for="Id" />
                    <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-2"></i>Supprimer</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Annuler</a>
                </form>
            </div>
        </div>
    </div>
</div>
