@using Microsoft.AspNetCore.Identity
@using GestionFormations.Models
@inject SignInManager<Apprenant> SignInManager
@inject UserManager<Apprenant> UserManager

<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item">
        <span class="nav-link text-light">
            <i class="bi bi-person-circle me-1"></i>@User.Identity?.Name
        </span>
    </li>
    <li class="nav-item">
        <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button type="submit" class="nav-link btn btn-link text-warning"><i class="bi bi-box-arrow-right me-1"></i>Déconnexion</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link text-light" asp-area="Identity" asp-page="/Account/Register"><i class="bi bi-person-plus me-1"></i>Inscription</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-light" asp-area="Identity" asp-page="/Account/Login"><i class="bi bi-box-arrow-in-right me-1"></i>Connexion</a>
    </li>
}
</ul>
