<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GestionFormations</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body style="background-color: var(--surface-alt); color: var(--text); min-height: 100vh; display: flex; flex-direction: column;">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark shadow-sm" style="background: linear-gradient(135deg, #065f46 0%, #047857 100%) !important; padding: 0.75rem 0;">
            <div class="container-fluid px-4">
                <a class="navbar-brand fw-bold d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <span class="d-inline-flex align-items-center justify-content-center rounded-3 me-2 shadow-sm" style="width: 36px; height: 36px; background: #10b981; color: #fff;">
                        <i class="bi bi-mortarboard-fill fs-5"></i>
                    </span>
                    <span>GestionFormations</span>
                </a>
                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto align-items-lg-center gap-1">
                        <li class="nav-item">
                            <a class="nav-link px-3 py-2 rounded-3" asp-controller="Home" asp-action="Index" style="font-weight: 500;"><i class="bi bi-house-door me-1"></i>Accueil</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 py-2 rounded-3" asp-controller="Formations" asp-action="Index" style="font-weight: 500;"><i class="bi bi-book me-1"></i>Formations</a>
                        </li>
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link px-3 py-2 rounded-3" asp-controller="AiTrainer" asp-action="Index" style="font-weight: 500;"><i class="bi bi-robot me-1"></i>Formateur IA</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link px-3 py-2 rounded-3" asp-controller="Inscriptions" asp-action="Index" style="font-weight: 500;"><i class="bi bi-journal-check me-1"></i>Mes Inscriptions</a>
                            </li>
                        }
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle px-3 py-2 rounded-3" href="#" role="button" data-bs-toggle="dropdown" style="font-weight: 500;">
                                    <i class="bi bi-gear me-1"></i>Administration
                                </a>
                                <ul class="dropdown-menu dropdown-menu-dark border-0 shadow-lg p-2" style="border-radius: 0.75rem; background-color: #064e3b; margin-top: 0.5rem;">
                                    <li><a class="dropdown-item d-flex align-items-center rounded-2 py-2" asp-controller="Admin" asp-action="Dashboard"><i class="bi bi-speedometer2 me-2 text-success"></i>Dashboard</a></li>
                                    <li><hr class="dropdown-divider my-1 border-success opacity-25" /></li>
                                    <li><a class="dropdown-item d-flex align-items-center rounded-2 py-2" asp-controller="Formations" asp-action="Index"><i class="bi bi-book me-2"></i>Formations</a></li>
                                    <li><a class="dropdown-item d-flex align-items-center rounded-2 py-2" asp-controller="Formations" asp-action="Create"><i class="bi bi-plus-circle me-2 text-success"></i>Nouvelle Formation</a></li>
                                    <li><a class="dropdown-item d-flex align-items-center rounded-2 py-2" asp-controller="Categories" asp-action="Index"><i class="bi bi-tags me-2"></i>Catégories</a></li>
                                    <li><a class="dropdown-item d-flex align-items-center rounded-2 py-2" asp-controller="Formateurs" asp-action="Index"><i class="bi bi-person-badge me-2"></i>Formateurs</a></li>
                                    <li><a class="dropdown-item d-flex align-items-center rounded-2 py-2" asp-controller="Modules" asp-action="Index"><i class="bi bi-collection me-2"></i>Modules</a></li>
                                    <li><a class="dropdown-item d-flex align-items-center rounded-2 py-2" asp-controller="Contenus" asp-action="Index"><i class="bi bi-file-earmark-text me-2"></i>Contenus</a></li>
                                    <li><a class="dropdown-item d-flex align-items-center rounded-2 py-2" asp-controller="Questions" asp-action="Index"><i class="bi bi-question-circle me-2"></i>Questions</a></li>
                                    <li><hr class="dropdown-divider my-1 border-success opacity-25" /></li>
                                    <li><a class="dropdown-item d-flex align-items-center rounded-2 py-2" asp-controller="AdminInscriptions" asp-action="Index"><i class="bi bi-clipboard-check me-2 text-warning"></i>Inscriptions</a></li>
                                </ul>
                            </li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid px-4 py-4 flex-grow-1">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show d-flex align-items-center shadow-sm" role="alert" style="border-radius: 0.75rem; border: 1px solid #bbf7d0; background-color: #dcfce7; color: #166534;">
                <i class="bi bi-check-circle-fill me-2 fs-5"></i>
                <span class="flex-grow-1">@TempData["Success"]</span>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center shadow-sm" role="alert" style="border-radius: 0.75rem; border: 1px solid #fecaca; background-color: #fee2e2; color: #991b1b;">
                <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                <span class="flex-grow-1">@TempData["Error"]</span>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="alert"></button>
            </div>
        }
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="text-white py-4 mt-auto border-top border-success border-opacity-25" style="background: linear-gradient(135deg, #065f46 0%, #047857 100%) !important;">
        <div class="container text-center">
            <div class="d-flex align-items-center justify-content-center mb-2">
                <i class="bi bi-mortarboard-fill me-2"></i>
                <span class="fw-bold">GestionFormations</span>
            </div>
            <p class="mb-0 opacity-75 small">&copy; 2026 GestionFormations - Plateforme de formation en ligne</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>