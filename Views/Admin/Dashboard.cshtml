@model GestionFormations.Models.AdminDashboardViewModel
@{
    ViewData["Title"] = "Dashboard Administration";
}

<div class="page-header">
    <h2><i class="bi bi-speedometer2 me-2"></i>Dashboard Administration</h2>
    <p>Vue d'ensemble de la plateforme</p>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card stat-card" style="background:linear-gradient(135deg,#6366f1,#4f46e5);color:#fff;">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon" style="background:rgba(255,255,255,0.2);color:#fff;">
                    <i class="bi bi-book"></i>
                </div>
                <div>
                    <div class="stat-value text-white">@Model.TotalFormations</div>
                    <div class="stat-label" style="color:rgba(255,255,255,0.7);">Formations</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card" style="background:linear-gradient(135deg,#10b981,#059669);color:#fff;">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon" style="background:rgba(255,255,255,0.2);color:#fff;">
                    <i class="bi bi-person-badge"></i>
                </div>
                <div>
                    <div class="stat-value text-white">@Model.TotalFormateurs</div>
                    <div class="stat-label" style="color:rgba(255,255,255,0.7);">Formateurs</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card" style="background:linear-gradient(135deg,#3b82f6,#2563eb);color:#fff;">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon" style="background:rgba(255,255,255,0.2);color:#fff;">
                    <i class="bi bi-people"></i>
                </div>
                <div>
                    <div class="stat-value text-white">@Model.TotalApprenants</div>
                    <div class="stat-label" style="color:rgba(255,255,255,0.7);">Apprenants</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card" style="background:linear-gradient(135deg,#f59e0b,#d97706);color:#fff;">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon" style="background:rgba(255,255,255,0.2);color:#fff;">
                    <i class="bi bi-clipboard-check"></i>
                </div>
                <div>
                    <div class="stat-value text-white">@Model.InscriptionsEnAttente</div>
                    <div class="stat-label" style="color:rgba(255,255,255,0.7);">Insc. en attente</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card stat-card" style="border:none;box-shadow:var(--shadow);">
            <div class="card-body text-center">
                <div class="stat-value" style="color:var(--primary);">@Model.TotalCategories</div>
                <div class="stat-label">Catégories</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card" style="border:none;box-shadow:var(--shadow);">
            <div class="card-body text-center">
                <div class="stat-value" style="color:var(--primary);">@Model.TotalModules</div>
                <div class="stat-label">Modules</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card" style="border:none;box-shadow:var(--shadow);">
            <div class="card-body text-center">
                <div class="stat-value" style="color:var(--primary);">@Model.TotalContenus</div>
                <div class="stat-label">Contenus</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card" style="border:none;box-shadow:var(--shadow);">
            <div class="card-body text-center">
                <div class="stat-value" style="color:var(--success);">@Model.InscriptionsAcceptees</div>
                <div class="stat-label">Insc. acceptées</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <div class="card" style="border:none;box-shadow:var(--shadow);border-radius:var(--radius-lg);overflow:hidden;">
            <div class="card-header" style="background:linear-gradient(135deg,var(--darker),var(--dark));color:#fff;border:none;">
                <h5 class="mb-0"><i class="bi bi-clock-history me-2"></i>Dernières Inscriptions</h5>
            </div>
            <div class="card-body p-0">
                <div class="list-group list-group-flush">
                    @if (Model.DernieresInscriptions.Any())
                    {
                        @foreach (var ins in Model.DernieresInscriptions)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <strong>@ins.Apprenant?.Prenom @ins.Apprenant?.Nom</strong>
                                    <br /><small class="text-muted">@ins.Formation?.Titre</small>
                                </div>
                                <div class="text-end">
                                    @switch (ins.Statut)
                                    {
                                        case GestionFormations.Models.StatutInscription.EnAttente:
                                            <span class="badge bg-warning">En attente</span>
                                            break;
                                        case GestionFormations.Models.StatutInscription.Acceptee:
                                            <span class="badge bg-success">Acceptée</span>
                                            break;
                                        case GestionFormations.Models.StatutInscription.Refusee:
                                            <span class="badge bg-danger">Refusée</span>
                                            break;
                                        default:
                                            <span class="badge bg-info">Terminée</span>
                                            break;
                                    }
                                    <br /><small class="text-muted">@ins.DateInscription.ToString("dd/MM HH:mm")</small>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="list-group-item text-center text-muted py-4">
                            <i class="bi bi-inbox display-6 d-block mb-2" style="opacity:0.3;"></i>
                            Aucune inscription
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card" style="border:none;box-shadow:var(--shadow);border-radius:var(--radius-lg);overflow:hidden;">
            <div class="card-header" style="background:linear-gradient(135deg,var(--darker),var(--dark));color:#fff;border:none;">
                <h5 class="mb-0"><i class="bi bi-trophy me-2"></i>Formations Populaires</h5>
            </div>
            <div class="card-body p-0">
                <div class="list-group list-group-flush">
                    @if (Model.FormationsPopulaires.Any())
                    {
                        @foreach (var f in Model.FormationsPopulaires)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <strong>@f.Titre</strong>
                                    <br /><small class="text-muted">@f.Categorie?.Nom</small>
                                </div>
                                <span class="badge" style="background:linear-gradient(135deg,var(--primary),var(--primary-dark));color:#fff;">@f.Inscriptions.Count inscriptions</span>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="list-group-item text-center text-muted py-4">
                            <i class="bi bi-inbox display-6 d-block mb-2" style="opacity:0.3;"></i>
                            Aucune formation
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
