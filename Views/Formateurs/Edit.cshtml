@model GestionFormations.Models.Formateur
@{
    ViewData["Title"] = "Modifier le Formateur";
}

<div class="page-header">
    <h2><i class="bi bi-pencil me-2"></i>Modifier le Formateur</h2>
    <p>Mettre à jour les informations du formateur</p>
</div>

<div class="row g-4">
    <div class="col-md-8">
        <div class="card" style="border: none; border-radius: 1rem; box-shadow: 0 4px 20px rgba(0,0,0,0.06);">
            <div class="card-body p-4">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="Id" />
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Nom" class="form-label fw-semibold text-uppercase small"></label>
                            <input asp-for="Nom" class="form-control" style="border: 2px solid #dee2e6; border-radius: 0.5rem;" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Prenom" class="form-label fw-semibold text-uppercase small"></label>
                            <input asp-for="Prenom" class="form-control" style="border: 2px solid #dee2e6; border-radius: 0.5rem;" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold text-uppercase small"></label>
                        <input asp-for="Email" class="form-control" type="email" style="border: 2px solid #dee2e6; border-radius: 0.5rem;" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Telephone" class="form-label fw-semibold text-uppercase small"></label>
                        <input asp-for="Telephone" class="form-control" style="border: 2px solid #dee2e6; border-radius: 0.5rem;" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Specialite" class="form-label fw-semibold text-uppercase small"></label>
                        <input asp-for="Specialite" class="form-control" style="border: 2px solid #dee2e6; border-radius: 0.5rem;" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Biographie" class="form-label fw-semibold text-uppercase small"></label>
                        <textarea asp-for="Biographie" class="form-control" rows="3" style="border: 2px solid #dee2e6; border-radius: 0.5rem;"></textarea>
                    </div>
                    <div class="mb-3">
                        <label asp-for="PhotoUrl" class="form-label fw-semibold text-uppercase small"></label>
                        <input asp-for="PhotoUrl" class="form-control" style="border: 2px solid #dee2e6; border-radius: 0.5rem;" />
                    </div>
                    <div class="mb-3 form-check">
                        <input asp-for="EstActif" class="form-check-input" />
                        <label asp-for="EstActif" class="form-check-label fw-semibold"></label>
                    </div>
                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-2"></i>Enregistrer</button>
                        <a asp-action="Index" class="btn btn-secondary">Annuler</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
