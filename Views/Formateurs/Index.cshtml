@model IEnumerable<GestionFormations.Models.Formateur>
@{
    ViewData["Title"] = "Formateurs";
}

<div class="page-header">
    <h2><i class="bi bi-person-badge me-2"></i>Formateurs</h2>
    <p>Gestion des formateurs de l'organisme</p>
</div>

<div class="d-flex justify-content-end mb-4">
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus me-2"></i>Ajouter</a>
</div>

<div class="row g-4">
    @foreach (var item in Model)
    {
        <div class="col-md-4">
            <div class="card h-100" style="border: none; border-radius: 1rem; box-shadow: 0 4px 20px rgba(0,0,0,0.06);">
                <div class="card-body text-center p-4">
                    @if (!string.IsNullOrEmpty(item.PhotoUrl))
                    {
                        <img src="@item.PhotoUrl" class="rounded-circle mb-3" alt="@item.Prenom" style="width:80px;height:80px;object-fit:cover;" />
                    }
                    else
                    {
                        <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width:80px;height:80px;">
                            <i class="bi bi-person display-5"></i>
                        </div>
                    }
                    <h5 class="fw-bold">@item.Prenom @item.Nom</h5>
                    <p class="text-muted small mb-2">@item.Specialite</p>
                    <span class="badge @(item.EstActif ? "bg-success" : "bg-secondary") rounded-pill">@(item.EstActif ? "Actif" : "Inactif")</span>
                </div>
                <div class="card-footer bg-white border-0 text-center pb-4 pt-0">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info"><i class="bi bi-info-circle"></i></a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
                </div>
            </div>
        </div>
    }
</div>
