@model GestionFormations.Models.Contenu
@{
    ViewData["Title"] = "Passer le Quiz";
}

<div class="page-header">
    <h2><i class="bi bi-clipboard-check me-2"></i>@Model.Titre</h2>
    <p>@Model.Module?.Formation?.Titre - @Model.Module?.Titre</p>
</div>

@if (Model.Questions == null || !Model.Questions.Any())
{
    <div class="card" style="border: none; border-radius: 1rem; box-shadow: 0 4px 20px rgba(0,0,0,0.06);">
        <div class="card-body text-center p-5">
            <i class="bi bi-exclamation-circle text-warning display-4"></i>
            <p class="mt-3 fs-5">Aucune question disponible pour ce quiz.</p>
        </div>
    </div>
}
else
{
    <div class="card mb-4" style="border: none; border-radius: 1rem; box-shadow: 0 4px 20px rgba(0,0,0,0.06);">
        <div class="card-body p-4">
            <div class="alert alert-info mb-0">
                <i class="bi bi-info-circle me-2"></i>
                <strong>@Model.Questions.Count questions</strong> -
                Points totaux : @Model.Questions.Sum(q => q.Points)
            </div>
        </div>
    </div>

    <form asp-action="Soumettre" method="post">
        <input type="hidden" name="contenuId" value="@Model.Id" />

        @{ int qNum = 1; }
        @foreach (var question in Model.Questions)
        {
            <div class="card mb-4" style="border: none; border-radius: 1rem; box-shadow: 0 4px 20px rgba(0,0,0,0.06);">
                <div class="card-header bg-light" style="border-radius: 1rem 1rem 0 0;">
                    <div class="d-flex justify-content-between align-items-center">
                        <strong class="fs-5"><i class="bi bi-chat-left-text me-2"></i>Question @qNum</strong>
                        <span class="badge bg-secondary rounded-pill">@question.Points points</span>
                    </div>
                </div>
                <div class="card-body p-4">
                    <p class="fs-5 mb-3">@question.Enonce</p>

                    @if (question.Type == GestionFormations.Models.TypeQuestion.QCM || question.Type == GestionFormations.Models.TypeQuestion.VraiFaux)
                    {
                        @foreach (var choix in question.ChoixReponses)
                        {
                            <div class="form-check mb-2 p-3" style="border: 2px solid #dee2e6; border-radius: 0.5rem;">
                                <input class="form-check-input" type="radio" name="reponses[@question.Id]" value="@choix.Id" id="choix_@choix.Id" />
                                <label class="form-check-label ms-2" for="choix_@choix.Id">@choix.Texte</label>
                            </div>
                        }
                    }
                </div>
            </div>
            qNum++;
        }

        <div class="text-center mt-4">
            <button type="submit" class="btn btn-primary btn-lg px-5">
                <i class="bi bi-send me-2"></i>Soumettre le quiz
            </button>
        </div>
    </form>
}
