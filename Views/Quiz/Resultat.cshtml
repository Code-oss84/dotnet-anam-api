@{
    ViewData["Title"] = "Résultat du Quiz";
}

<div class="text-center py-5">
    <div class="mb-4">
        <i class="bi bi-check-circle-fill text-success" style="font-size: 5rem;"></i>
    </div>
    <h2 class="fw-bold">Résultat du Quiz</h2>

    <div class="card mx-auto mt-4" style="border: none; border-radius: 1rem; box-shadow: 0 4px 20px rgba(0,0,0,0.06); max-width: 400px;">
        <div class="card-body text-center p-5">
            <h1 class="display-4 fw-bold text-primary mb-0">@ViewBag.Note/20</h1>
            <hr class="my-3" />
            <p class="text-muted"><strong>Points obtenus :</strong> @ViewBag.Obtained / @ViewBag.Total</p>
            @{
                var note = (double)ViewBag.Note;
                string message, cssClass;
                if (note >= 16) { message = "Excellent !"; cssClass = "text-success"; }
                else if (note >= 12) { message = "Bien !"; cssClass = "text-primary"; }
                else if (note >= 10) { message = "Passable"; cssClass = "text-warning"; }
                else { message = "À retravailler"; cssClass = "text-danger"; }
            }
            <h4 class="@cssClass mt-3 fw-bold">@message</h4>
        </div>
    </div>

    <div class="mt-4 d-flex justify-content-center gap-3">
        <a asp-controller="Formations" asp-action="Index" class="btn btn-primary">
            <i class="bi bi-book me-2"></i>Retour aux formations
        </a>
        <a asp-controller="Inscriptions" asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-journal-check me-2"></i>Mes inscriptions
        </a>
    </div>
</div>
