@model GestionFormations.Models.Question
@{
    ViewData["Title"] = "Détails de la Question";
}

<div class="page-header">
    <h2><i class="bi bi-question-circle me-2"></i>Question</h2>
    <p>Détails de la question</p>
</div>

<div class="row g-4">
    <div class="col-md-8">
        <div class="card" style="border: none; border-radius: 1rem; box-shadow: 0 4px 20px rgba(0,0,0,0.06);">
            <div class="card-body p-4">
                <p class="fs-5 fw-bold">@Model.Enonce</p>
                <div class="mb-3">
                    <span class="badge bg-info rounded-pill">@Model.Type</span>
                    <span class="badge bg-secondary rounded-pill">@Model.Points points</span>
                </div>

                @if (Model.ChoixReponses != null && Model.ChoixReponses.Any())
                {
                    <div class="list-group mt-3">
                        @foreach (var choix in Model.ChoixReponses)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center" style="border-radius: 0.5rem; border: 2px solid #dee2e6; margin-bottom: 0.5rem;">
                                <span>@choix.Texte</span>
                                @if (choix.EstCorrect)
                                {
                                    <span class="badge bg-success rounded-pill"><i class="bi bi-check-lg"></i> Correct</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger rounded-pill"><i class="bi bi-x-lg"></i></span>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
            <div class="card-footer bg-white border-0 pb-4">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary"><i class="bi bi-pencil me-2"></i>Modifier</a>
                <a asp-action="Index" asp-route-contenuId="@Model.ContenuId" class="btn btn-secondary">Retour</a>
            </div>
        </div>
    </div>
</div>
