@model GestionFormations.Models.Question
@{
    ViewData["Title"] = "Supprimer la Question";
}

<div class="page-header">
    <h2 class="text-danger"><i class="bi bi-trash me-2"></i>Supprimer la Question</h2>
    <p>Confirmer la suppression</p>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <div class="card" style="border: none; border-radius: 1rem; box-shadow: 0 4px 20px rgba(0,0,0,0.06);">
            <div class="card-body p-4">
                <p class="fs-5 fw-bold">@Model.Enonce</p>
                <p class="text-muted">Type : @Model.Type | Points : @Model.Points</p>
                <div class="alert alert-warning mt-3">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    Êtes-vous sûr de vouloir supprimer cette question ?
                </div>
                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-2"></i>Supprimer</button>
                        <a asp-action="Index" class="btn btn-secondary">Annuler</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
